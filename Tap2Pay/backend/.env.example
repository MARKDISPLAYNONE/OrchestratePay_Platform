# ─────────────────────────────────────────────────────────────────────────────
# OrchestratePay Backend — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://orchestrate:yourpassword@localhost:5432/orchestratepay

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Daraja (M-Pesa) ──────────────────────────────────────────────────────────
# Get credentials from https://developer.safaricom.co.ke
DARAJA_CONSUMER_KEY=your_consumer_key_here
DARAJA_CONSUMER_SECRET=your_consumer_secret_here
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
DARAJA_CALLBACK_BASE_URL=https://your-public-domain.co.ke
# DARAJA_ENVIRONMENT=sandbox     # set to 'production' for live

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')" | pbcopy
JWT_SECRET=replace_with_64_char_random_hex_string
ADMIN_SECRET=replace_with_strong_admin_secret
NFC_SIGNING_SECRET=replace_with_nfc_signing_secret

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Sentry (auto-activates when set) ─────────────────────────────────────────
# SENTRY_DSN=https://your-key@sentry.io/your-project-id

# ── Africa's Talking SMS (auto-activates when AT_API_KEY is set) ─────────────
SMS_ENABLED=true
# AT_API_KEY=your_at_api_key
# AT_USERNAME=sandbox             # set to your registered AT username in production
# AT_SENDER_ID=OrchstPay          # max 11 chars

# ── Firebase Cloud Messaging (auto-activates when set) ───────────────────────
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── KRA eTIMS ─────────────────────────────────────────────────────────────────
# ETIMS_BASE_URL=https://etims-api.kra.go.ke
# ETIMS_API_KEY=your_kra_api_key

# ── Open Exchange Rates (FX, auto-activates when set) ─────────────────────────
# OPENEXCHANGERATES_APP_ID=your_app_id

# ── Play Integrity / SoftPOS ─────────────────────────────────────────────────
PLAY_INTEGRITY_REQUIRED=false
# Set to 'true' in production and configure decryption key from Google Cloud
# PLAY_INTEGRITY_DECRYPTION_KEY=base64_encoded_key

# ── Fraud scoring tuning (optional) ──────────────────────────────────────────
# FRAUD_VELOCITY_WINDOW_S=60
# FRAUD_VELOCITY_MAX_TXNS=10
# FRAUD_AMOUNT_FACTOR=3.0
