{
  "name": "orchestratepay",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test":              "npm --prefix backend test && npm --prefix web run test:unit",
    "test:coverage":     "npm --prefix backend run test:coverage && npm --prefix web run test:unit:coverage",
    "test:backend":      "npm --prefix backend test",
    "test:backend:watch":"npm --prefix backend run test:watch",
    "test:backend:coverage": "npm --prefix backend run test:coverage",
    "test:web":          "npm --prefix web run test:unit",
    "test:web:watch":    "npm --prefix web run test:unit:watch",
    "test:web:coverage": "npm --prefix web run test:unit:coverage",
    "test:e2e":          "npm --prefix web run test:e2e",
    "test:e2e:headed":   "npm --prefix web run test:e2e:headed",
    "test:e2e:ui":       "npm --prefix web run test:e2e:ui",
    "test:android":      "cd android && ./gradlew test",
    "test:android:app":  "cd android && ./gradlew :app:test",
    "test:android:wallet":"cd android && ./gradlew :consumer-wallet:test",
    "dev:backend":       "npm --prefix backend run dev",
    "dev:web":           "npm --prefix web run dev",
    "build:backend":     "npm --prefix backend run build",
    "build:web":         "npm --prefix web run build",
    "lint":              "npm --prefix backend run lint && npm --prefix web run lint",
    "migrate":           "npm --prefix backend run migrate"
  }
}
