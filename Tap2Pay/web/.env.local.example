# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# Must match the JWT_SECRET used by the backend.
# Without this, Next.js middleware rejects all /consumer and /merchant routes.
JWT_SECRET=your-256-bit-secret-here

# Backend API base URL (local dev: backend runs on :3000, web on :3001)
NEXT_PUBLIC_API_URL=http://localhost:3000
