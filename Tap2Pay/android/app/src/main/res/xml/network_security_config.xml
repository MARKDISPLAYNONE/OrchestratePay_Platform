<?xml version="1.0" encoding="utf-8"?>
<!--
  network_security_config.xml

  SSL certificate pinning for the OrchestratePay terminal app.

  HOW TO EXTRACT THE PRODUCTION PIN (run before every certificate renewal):
    openssl s_client -connect api.orchestratepay.co.ke:443 </dev/null 2>/dev/null \
      | openssl x509 -pubkey -noout \
      | openssl pkey -pubin -outform der \
      | openssl dgst -sha256 -binary \
      | base64

  Replace the PRIMARY pin below with the output. Keep the BACKUP pin as the CA
  intermediate or a pre-generated future key so you have a rotation path.
  Update the expiration date to 90 days before your TLS certificate expires.

  WARNING: A wrong primary pin with no valid backup pin will break ALL connections
  in release builds. Always test on a device before shipping.
-->
<network-security-config>

    <!-- Debug builds: trust user-installed CAs so Charles/mitmproxy work during dev -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Production API: pin to the leaf cert + CA backup -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.orchestratepay.co.ke</domain>
        <pin-set expiration="2027-01-01">
            <!-- PRIMARY: SHA-256 of SubjectPublicKeyInfo — REPLACE BEFORE RELEASE -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <!-- BACKUP: pin of the CA intermediate or a rotation key -->
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Local development: allow cleartext to emulator host and USB-forwarded port -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- Default for all other domains: HTTPS only, no user CAs -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
