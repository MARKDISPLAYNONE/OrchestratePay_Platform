<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ── Status bar (connectivity + info) ─────────────────────────── -->
    <TextView
        android:id="@+id/tv_status_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:background="#388E3C"
        android:paddingVertical="6dp"
        android:paddingHorizontal="16dp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Merchant name header ──────────────────────────────────────── -->
    <TextView
        android:id="@+id/tv_merchant_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1B5E20"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_status_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Amount display ───────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tv_amount_display"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="KSh 0.00"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:gravity="center"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_merchant_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── NFC tap indicator ─────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tv_tap_prompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ready_to_tap"
        android:textSize="16sp"
        android:textColor="#616161"
        android:gravity="center"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_amount_display"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Number keypad ─────────────────────────────────────────────── -->
    <GridLayout
        android:id="@+id/keypad_grid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_tap_prompt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_1" android:text="1" style="@style/KeypadButton" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_2" android:text="2" style="@style/KeypadButton" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_3" android:text="3" style="@style/KeypadButton" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_4" android:text="4" style="@style/KeypadButton" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_5" android:text="5" style="@style/KeypadButton" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_6" android:text="6" style="@style/KeypadButton" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_7" android:text="7" style="@style/KeypadButton" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_8" android:text="8" style="@style/KeypadButton" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_9" android:text="9" style="@style/KeypadButton" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear" android:text="C" style="@style/KeypadButton"
            app:backgroundTint="#EF5350" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_0" android:text="0" style="@style/KeypadButton" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm" android:text="✓" style="@style/KeypadButton"
            app:backgroundTint="#2E7D32" />
    </GridLayout>

    <!-- ── Processing overlay ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layout_processing"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F5F5F5"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/tv_amount_display"
        app:layout_constraintBottom_toBottomOf="@id/keypad_grid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp" />

        <TextView
            android:id="@+id/tv_processing_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/waiting_for_customer"
            android:textSize="16sp"
            android:textColor="#424242"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- ── Result banner (SUCCESS / DECLINED / ERROR) ─────────────────── -->
    <LinearLayout
        android:id="@+id/layout_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/keypad_grid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_result_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="48sp" />

        <TextView
            android:id="@+id/tv_result_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="18sp"
            android:textColor="#212121"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retry"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            app:backgroundTint="#2E7D32" />
    </LinearLayout>

    <!-- ── Action buttons row ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layout_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scan_qr"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_scan_qr"
            android:textSize="13sp"
            app:backgroundTint="#1565C0"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_present_nfc"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_present_nfc"
            android:textSize="13sp"
            app:backgroundTint="#6A1B9A"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
