<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- OrchestratePay green (inspired by M-Pesa branding) -->
    <style name="Theme.OrchestratePay" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">#1D9E75</item>
        <item name="colorPrimaryVariant">#0F6E56</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#534AB7</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">#0F6E56</item>
    </style>

    <style name="KeypadButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:textSize">22sp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="backgroundTint">#424242</item>
    </style>
</resources>
