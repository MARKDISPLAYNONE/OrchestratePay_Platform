<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1B2A">

    <!-- Amount label -->
    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="KSh 0.00"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp" />

    <!-- Instruction label -->
    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Hold customer's phone here"
        android:textSize="18sp"
        android:textColor="#B0BEC5"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvAmount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Pulsing ring container — positioned dynamically by TapGuideActivity -->
    <!-- TOP position: vertically centered in top third (translationY set in code) -->
    <!-- CENTER position: default (no translation) -->
    <!-- BOTTOM position: translationY to bottom third -->
    <FrameLayout
        android:id="@+id/ringContainer"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Outer ring (animated scale + alpha) -->
        <View
            android:id="@+id/ringOuter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ring_pulse_outer"
            android:alpha="0.4" />

        <!-- Inner ring (slightly delayed pulse) -->
        <View
            android:id="@+id/ringInner"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/ring_pulse_inner"
            android:alpha="0.7" />

        <!-- NFC icon -->
        <TextView
            android:id="@+id/tvNfcIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="⟳"
            android:textSize="48sp"
            android:textColor="#FFFFFF" />
    </FrameLayout>

    <!-- Cancel button -->
    <Button
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textColor="#FFFFFF"
        android:backgroundTint="#C62828"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="48dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
