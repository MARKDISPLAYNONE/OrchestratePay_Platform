<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="24dp">

    <!-- ── Header ─────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="OrchestratePay SoftPOS"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Amount display ─────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvAmountDisplay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="KSh 0.00"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:gravity="center"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- ── Status bar ─────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvStatusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Offline — payments unavailable"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:background="#C62828"
        android:paddingVertical="8dp"
        android:paddingHorizontal="12dp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvAmountDisplay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Keypad grid ────────────────────────────────────────────────── -->
    <GridLayout
        android:id="@+id/keypadGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        app:layout_constraintTop_toBottomOf="@id/tvStatusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <Button android:id="@+id/btn1" android:text="1" style="@style/KeypadButton" />
        <Button android:id="@+id/btn2" android:text="2" style="@style/KeypadButton" />
        <Button android:id="@+id/btn3" android:text="3" style="@style/KeypadButton" />
        <Button android:id="@+id/btn4" android:text="4" style="@style/KeypadButton" />
        <Button android:id="@+id/btn5" android:text="5" style="@style/KeypadButton" />
        <Button android:id="@+id/btn6" android:text="6" style="@style/KeypadButton" />
        <Button android:id="@+id/btn7" android:text="7" style="@style/KeypadButton" />
        <Button android:id="@+id/btn8" android:text="8" style="@style/KeypadButton" />
        <Button android:id="@+id/btn9" android:text="9" style="@style/KeypadButton" />
        <Button android:id="@+id/btnClear" android:text="C"
            style="@style/KeypadButton"
            android:backgroundTint="#E65100" />
        <Button android:id="@+id/btn0" android:text="0" style="@style/KeypadButton" />
        <Button android:id="@+id/btnConfirm" android:text="✓"
            style="@style/KeypadButton"
            android:backgroundTint="#2E7D32" />
    </GridLayout>

    <!-- ── Tap prompt ─────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvTapPrompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Hold customer's phone here to tap"
        android:textSize="16sp"
        android:textColor="#616161"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/keypadGrid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- ── Processing spinner ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutProcessing"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/keypadGrid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/tvProcessingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Processing payment..."
            android:textSize="15sp"
            android:textColor="#424242"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- ── Result panel ───────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/keypadGrid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tvResultIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textSize="72sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvResultMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="#424242"
            android:gravity="center"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
