<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.orchestratepay.wallet">

    <!-- ── Permissions ───────────────────────────────────────────────────── -->

    <!-- NFC hardware access — required for HCE -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- Internet — for calling POST /api/v1/wallet/session -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ── Hardware features ─────────────────────────────────────────────── -->

    <!-- required=true: the wallet app is useless without NFC -->
    <uses-feature android:name="android.hardware.nfc" android:required="true" />

    <!-- HCE requires API 19+ and the nfc.hce feature -->
    <uses-feature android:name="android.hardware.nfc.hce" android:required="true" />

    <!-- ── Application ───────────────────────────────────────────────────── -->

    <application
        android:name=".WalletApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- ── Main UI ───────────────────────────────────────────────────── -->

        <activity
            android:name=".ui.ActivatePaymentActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── HCE Service ───────────────────────────────────────────────── -->
        <!--
            BIND_NFC_SERVICE: Android system requires this exact permission to bind
            to our HostApduService. Without it, Android refuses to route APDU traffic.

            android:exported="true": must be true so the Android NFC framework
            (a different process) can bind to this service.

            android:permission="android.permission.BIND_NFC_SERVICE": only the Android
            NFC system (which holds this permission) can bind — no other app can.

            The meta-data resource (apduservice.xml) declares the AID filter that tells
            Android WHICH SELECT AID commands to route here.
        -->
        <service
            android:name=".hce.WalletHceService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apduservice" />
        </service>

    </application>

</manifest>
